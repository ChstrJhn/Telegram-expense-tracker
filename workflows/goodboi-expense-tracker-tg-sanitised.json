    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json.raw_text;\nconst chat_id = $input.first().json.chat_id;\nconst raw_input_original = $input.first().json.raw_input_original;\n\n// Extract Gemini's text response from the nested response object\n\n// Remove markdown code blocks if Gemini added them (safety net)\nconst cleaned = inputData.replace(/```json\\n?/g, '').replace(/```\\n?/g, '').trim();\n\nlet parsed;\ntry {\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  return [{ json: { parse_error: true, chat_id, raw_input_original } }];\n}\n\nif (parsed.error === 'not_an_expense') {\n  return [{ json: { not_expense: true, chat_id } }];\n}\n\n// Normalise into array — handles both single object and expenses array\nlet expenses = parsed.expenses && Array.isArray(parsed.expenses)\n  ? parsed.expenses\n  : [parsed];\n\n// Normalise each expense's field names\nexpenses = expenses.map(exp => ({\n  category: exp.category || 'Other',\n  item_name: exp.item || exp.item_name || exp.name || 'Unknown',\n  quantity: exp.quantity || 1,\n  amount_rm: exp.price || exp.amount_rm || exp.amount || null,\n  payment_method: exp.payment_method || 'Unknown',\n  date: exp.date || 'Unknown'\n}));\n\nconst emoji = {\n  'Groceries': '🛒', 'Dining out': '🍽️', 'Coffee & snacks': '☕',\n  'Fuel': '⛽', 'Public transport': '🚌', 'Ride-sharing & taxis': '🚗',\n  'Parking & tolls': '🅿️', 'Home supplies': '🏠', 'Home maintenance': '🔧',\n  'Personal grooming': '💈', 'Personal health': '💊', 'Hobbies': '🎮',\n  'Events & outings': '🎉', 'Shopping': '🛍️', 'Pet food & treats': '🐾',\n  'Pet care': '🐶', 'Gifts': '🎁', 'Other': '📌'\n};\n\n// Escape special characters for Telegram MarkdownV2\n// Required characters: . ! - ( ) [ ] { } > # + = | ~ must all be escaped\nconst esc = (text) => String(text).replace(/[_*[\\]()~`>#+\\-=|{}.!]/g, '\\\\$&');\n\n// Build confirmation message — lists all expenses if there are multiple\nconst lines = expenses.map((exp, i) => {\n  const e = emoji[exp.category] || '📌';\n  return `*${i + 1}\\\\.* ${e} ${esc(exp.item_name)} x${esc(exp.quantity)} — RM${esc(Number(exp.amount_rm).toFixed(2))} · ${esc(exp.payment_method)} · ${esc(exp.date)}`;\n}).join('\\n');\n\nconst confirmMessage = `📋 *Here's what I captured:*\\n\\n${lines}\\n\\nReply ✅ to save all, ❌ to discard, or type a correction\\\\.`;\n\n// Return ONE item containing the full expenses array\n// The Split Out node downstream will split this into individual rows for Google Sheets\nreturn [{\n  json: {\n    parsed_expenses: expenses,\n    confirm_message: confirmMessage,\n    chat_id,\n    raw_input_original\n  }\n}];"
      },
